node_modules
.yarn/*
!.yarn/releases/
!.yarn/releases/yarn-*.cjs
dist
dist-electron
# electron-builder output directory — anchored & trailing slash so it only
# matches the top-level build output, not files named "release" elsewhere
# in the tree (e.g. bin/release).
/release/
build
.DS_Store

# Belt-and-braces: explicitly un-ignore the release helper script.
!/bin/release

**/**.log
coverage
captures
/test-results/
/playwright-report/

# Generated by scripts/extract-fixtures.mjs from local GTV_CAPTURE sessions.
# They can contain protocol traffic and voice audio; review and hand-copy
# minimal, anonymised data into a new fixture instead of committing these.
/src/backend/__fixtures__/ipc-session.json
/src/backend/discovery/__fixtures__/discovery-session.json
/src/backend/voice/__fixtures__/voice-session.json
/src/backend/voice/__fixtures__/voice-chunks-concatenated.bin
/src/backend/transport/framing/__fixtures__/inbound-frames-meta.json
/src/backend/transport/framing/__fixtures__/frames/
